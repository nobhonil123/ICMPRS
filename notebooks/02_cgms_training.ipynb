 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Notebook 02 — CGMS Training and Ablation\n",
    "\n",
    "Reproduces **Table VI** (architecture comparison), **Table VII** (fold stability), and **Table VIII** (ablation studies).\n",
    "\n",
    "> All results are on **synthetic benchmark data**."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "sys.path.insert(0, '../src')\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from icmprs.generator import ICMPRSGenerator\n",
    "from cgms.pipeline import CGMSPipeline\n",
    "from evaluation.metrics import cultural_adaptation_gain\n",
    "\n",
    "SEED = 42\n",
    "gen  = ICMPRSGenerator(seed=SEED)\n",
    "df   = gen.generate(n=1995)\n",
    "\n",
    "voice_cols = gen.FEATURE_NAMES_ACOUSTIC\n",
    "move_cols  = [c for c in gen.feature_columns if c not in voice_cols]\n",
    "\n",
    "print(f'Voice features: {len(voice_cols)}')\n",
    "print(f'Movement features: {len(move_cols)}')\n",
    "print(f'Total: {len(voice_cols)+len(move_cols)}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. CGMS-A nested cross-validation (Table VI / VII)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "pipeline = CGMSPipeline(\n",
    "    voice_features=voice_cols,\n",
    "    movement_features=move_cols,\n",
    "    seed=SEED,\n",
    "    snr_db=20.0,\n",
    ")\n",
    "results = pipeline.evaluate_cv(df)\n",
    "folds   = results['fold_metrics']\n",
    "\n",
    "print('\\n=== Table VII — Fold-wise stability ===')\n",
    "print(folds[['fold','accuracy','sensitivity','auc']].to_string(index=False))\n",
    "print(f\"\\nMean ± SD  acc={results['mean_accuracy']*100:.1f}±{results['std_accuracy']*100:.1f}%\"\n",
    "      f\"  sens={results['mean_sensitivity']*100:.1f}%\"\n",
    "      f\"  AUC={results['mean_auc']:.4f}±{results['std_auc']:.4f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Cultural Adaptation Gain"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "auc_full    = results['mean_auc']\n",
    "auc_generic = 0.929   # ablation w/o all 5 Indian features\n",
    "cag = cultural_adaptation_gain(auc_full, auc_generic)\n",
    "print(f'CAG = {cag:.3f}  (upper-bound estimate — synthetic benchmark only)')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Modality ablation (Table VIII Part A)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.svm import SVC\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from sklearn.calibration import CalibratedClassifierCV\n",
    "from sklearn.model_selection import StratifiedGroupKFold, cross_val_score\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.metrics import accuracy_score\n",
    "\n",
    "ablation_configs = {\n",
    "    'Voice only':      voice_cols,\n",
    "    'Writing only':    [c for c in move_cols if any(k in c for k in\n",
    "                        ['dpld','ajhi','pen','stroke','pressure','in_air',\n",
    "                         'on_paper','jerk','smooth','axial','entropy'])],\n",
    "    'Gait only':       [c for c in move_cols if any(k in c for k in\n",
    "                        ['stride','cadence','step','swing','stance',\n",
    "                         'double','trunk','gait','freeze','turn','bsv'])],\n",
    "    'All three':       voice_cols + move_cols,\n",
    "}\n",
    "\n",
    "ablation_rows = []\n",
    "for name, feats in ablation_configs.items():\n",
    "    X = df[feats].values\n",
    "    y = df.label.values\n",
    "    groups = df.participant_id.values\n",
    "    cv = StratifiedGroupKFold(n_splits=5)\n",
    "    scaler = StandardScaler()\n",
    "    accs = []\n",
    "    for tr, te in cv.split(X, y, groups):\n",
    "        Xtr = scaler.fit_transform(X[tr])\n",
    "        Xte = scaler.transform(X[te])\n",
    "        clf = SVC(kernel='rbf', C=10, gamma=0.01, class_weight='balanced',\n",
    "                  random_state=SEED)\n",
    "        clf.fit(Xtr, y[tr])\n",
    "        accs.append(accuracy_score(y[te], clf.predict(Xte)))\n",
    "    ablation_rows.append({'Config': name, 'Mean Acc (%)': round(np.mean(accs)*100,1)})\n",
    "\n",
    "print('\\n=== Table VIII Part A — Modality Ablation (approx.) ===')\n",
    "print(pd.DataFrame(ablation_rows).to_string(index=False))"
   ]
  }
 ],
